# ---------------------------------------------------------------------------
# Web application environment
# Copy to apps/web/.env.local. Never commit the real file.
# ---------------------------------------------------------------------------

# Base URL of the Express API. Server-side only; never exposed to the browser.
API_URL=http://localhost:4000

# Canonical public origin, used for metadata and absolute URLs.
#
# REQUIRED in production (NODE_ENV=production): a build or start without this
# value fails with a clear configuration error, because every canonical link and
# Open Graph URL would otherwise point at localhost.
#
# Production rules: absolute https:// URL on a non-local host.
# Local development: optional. When absent it falls back to http://localhost:3000.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Reported by /api/health.
WEB_VERSION=0.0.0-dev
