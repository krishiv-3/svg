# ---------------------------------------------------------------------------
# API environment — TEST template
# Copy to apps/api/.env.test. Integration tests load this file automatically
# (with override), so they can never run against the development database.
#
# The API refuses to start when APP_ENV=test and the database name does not
# end with `_test`.
# ---------------------------------------------------------------------------

NODE_ENV=test
APP_ENV=test

PORT=4001
HOST=127.0.0.1
TRUST_PROXY=false

LOG_LEVEL=error
LOG_PRETTY=false

SITE_URL=http://localhost:3000
CORS_ORIGINS=http://localhost:3000

ADMIN_DATABASE_URL=postgresql://postgres:postgres@localhost:5432/postgres
MIGRATE_DATABASE_URL=postgresql://gaushala_owner:gaushala_owner_dev@localhost:5432/gaushala_test
DATABASE_URL=postgresql://gaushala_app:gaushala_app_dev@localhost:5432/gaushala_test

APP_VERSION=0.0.0-test
SHUTDOWN_TIMEOUT_MS=5000

SEED_SUPER_ADMIN_EMAIL=admin@localhost.invalid
SEED_SUPER_ADMIN_NAME=Super Admin
