# ---------------------------------------------------------------------------
# API environment — PRODUCTION template
#
# This file documents the required variables ONLY. It contains no real values
# and must never be copied into the repository with secrets filled in.
# Provide these through the platform's secret store.
# ---------------------------------------------------------------------------

NODE_ENV=production
APP_ENV=production

PORT=4000
HOST=0.0.0.0
# Enable only behind a trusted reverse proxy / load balancer.
TRUST_PROXY=true

LOG_LEVEL=info
LOG_PRETTY=false

# Must be https://
SITE_URL=https://example.org
CORS_ORIGINS=https://example.org

# Managed PostgreSQL, private networking, TLS enforced.
# The application role must not own the schema and must not have DDL rights.
ADMIN_DATABASE_URL=
MIGRATE_DATABASE_URL=postgresql://gaushala_owner:REPLACE_ME@db.internal:5432/gaushala?sslmode=require
DATABASE_URL=postgresql://gaushala_app:REPLACE_ME@db.internal:5432/gaushala?sslmode=require

APP_VERSION=0.0.0
GIT_SHA=

SHUTDOWN_TIMEOUT_MS=15000

SEED_SUPER_ADMIN_EMAIL=
SEED_SUPER_ADMIN_NAME=
