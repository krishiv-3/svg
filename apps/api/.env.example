# ---------------------------------------------------------------------------
# API environment — DEVELOPMENT template
# Copy to apps/api/.env and adjust. Never commit the real file.
# ---------------------------------------------------------------------------

NODE_ENV=development
APP_ENV=development

# HTTP server
PORT=4000
HOST=0.0.0.0
TRUST_PROXY=false

# Logging: `debug` locally, `info` in production. LOG_PRETTY is ignored in production.
LOG_LEVEL=debug
LOG_PRETTY=true

# Public origin of the website (used for links and CORS)
SITE_URL=http://localhost:3000
CORS_ORIGINS=http://localhost:3000

# ---------------------------------------------------------------------------
# PostgreSQL — three roles, least privilege
#
#   ADMIN_DATABASE_URL    superuser, used only by scripts/db-bootstrap.mjs
#   MIGRATE_DATABASE_URL  owner, used only by the Prisma CLI (DDL)
#   DATABASE_URL          application runtime (DML only, cannot run DDL)
#
# The passwords below are local development values. Use generated secrets in
# every other environment.
# ---------------------------------------------------------------------------
ADMIN_DATABASE_URL=postgresql://postgres:postgres@localhost:5432/postgres
MIGRATE_DATABASE_URL=postgresql://gaushala_owner:gaushala_owner_dev@localhost:5432/gaushala_dev
DATABASE_URL=postgresql://gaushala_app:gaushala_app_dev@localhost:5432/gaushala_dev

# Reported by /version and sent in error reports
APP_VERSION=0.0.0-dev
# GIT_SHA=

# Graceful shutdown budget in milliseconds
SHUTDOWN_TIMEOUT_MS=10000

# Seed only. The account is created INVITED without a password; authentication
# arrives in Phase 7.
SEED_SUPER_ADMIN_EMAIL=admin@localhost.invalid
SEED_SUPER_ADMIN_NAME=Super Admin
