{
  "$schema": "https://turborepo.com/schema.json",
  "ui": "stream",
  "globalDependencies": [".env", "tsconfig.json"],
  "globalEnv": [
    "NODE_ENV",
    "APP_ENV",
    "DATABASE_URL",
    "MIGRATE_DATABASE_URL",
    "TEST_DATABASE_URL",
    "TEST_MIGRATE_DATABASE_URL",
    "ADMIN_DATABASE_URL"
  ],
  "tasks": {
    "generate": {
      "cache": true,
      "inputs": ["prisma/schema.prisma", "prisma.config.ts"],
      "outputs": ["src/generated/**"]
    },
    "build": {
      "dependsOn": ["^build", "generate"],
      "outputs": ["dist/**", ".next/**", "!.next/cache/**"]
    },
    "typecheck": {
      "dependsOn": ["^build", "generate"],
      "cache": true
    },
    "lint": {
      "cache": true
    },
    "test:unit": {
      "dependsOn": ["^build", "generate"],
      "cache": true
    },
    "test:integration": {
      "dependsOn": ["^build", "generate"],
      "cache": false
    },
    "dev": {
      "cache": false,
      "persistent": true
    },
    "clean": {
      "cache": false
    }
  }
}
